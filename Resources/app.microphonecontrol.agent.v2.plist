<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.microphonecontrol.agent.v2</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/MicrophoneControl</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MICROPHONE_CONTROL_MANAGED</key>
        <string>1</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
